# =============================================================
#  .gitignore — Godot 4 + Photoshop Project
#  Project: cc-main
# =============================================================

# ---------------------------------------------------------------
# GODOT ENGINE — Generated / Cached Files
# These are auto-regenerated by the engine and should NOT be
# tracked. Committing them causes constant merge conflicts and
# bloats your repo history.
# ---------------------------------------------------------------

# Godot's main cache directory (reimported assets, shaders, etc.)
.godot/

# Godot export templates and build artifacts
/android/
/ios/
/export/
/build/
*.export_presets.cfg.bak

# ---------------------------------------------------------------
# PHOTOSHOP & RAW ART SOURCE FILES
# Large binary source files — tracked via Git LFS (see .gitattributes)
# *.psd and *.psb are NOT ignored here; they are tracked by LFS.
# Photoshop scratch / auto-save / temp files are ignored below.
# ---------------------------------------------------------------

# Photoshop auto-save and temp files (these are junk, NOT your real work)
~*.psd
~*.psb
Backup_of_*.psd
*.psb~

# ---------------------------------------------------------------
# OPERATING SYSTEM JUNK
# ---------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ---------------------------------------------------------------
# COMMON IDE / EDITOR JUNK
# ---------------------------------------------------------------

# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains (Rider, etc.)
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo

# ---------------------------------------------------------------
# MONO / C# (if using Godot with C# support)
# ---------------------------------------------------------------
.mono/
data_*/
mono_crash.*.json
*.user
.vs/
[Bb]in/
[Oo]bj/
*.csproj.user

# ---------------------------------------------------------------
# GODOT EXPORT / BUILD OUTPUTS
# ---------------------------------------------------------------
*.apk
*.aab
*.ipa
*.exe
*.x86_64
*.pck
